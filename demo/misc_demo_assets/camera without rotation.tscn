[gd_scene format=3 uid="uid://bm03tdt5so3wj"]

[sub_resource type="GDScript" id="GDScript_1grwo"]
script/source = "extends Node3D
@export var show_crosshair : bool = false:
	set(x):
		show_crosshair = x
		$Camera3D/MeshInstance3D.visible = show_crosshair
@export var right_click_to_move : bool = true
@export var camera_distance : float = 0.0:
	set(x):
		camera_distance = x
		$Camera3D.position.z = camera_distance
@export var camera_height : float = 2.0:
	set(x):
		camera_height = x
		$Camera3D.position.y = camera_height
@export var camera_fov : float = 70.0:
	set(x):
		camera_fov = x
		$Camera3D.fov = camera_fov

func _ready() -> void:
	$Camera3D.position.z = camera_distance
	$Camera3D.position.y = camera_height
	$Camera3D.fov = camera_fov

func _process(delta: float) -> void:
	global_position = get_parent().global_position

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion and (Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT) or not right_click_to_move):
		rotation_degrees.x += -event.relative.y * 0.07
		rotation_degrees.y += -event.relative.x * 0.07
		get_viewport().set_input_as_handled()
"

