; Godot Aerodynamic Physics - C++ port (godot-cpp-components)
; The library is built with SCons inside godot-cpp-components/ and output to
; godot-cpp-components/bin/<platform>/libgodot_aerodynamic_physics.<platform>.<target>.double.x86_64.so
[configuration]
entry_symbol = "godot_aerodynamic_physics_init"
compatibility_minimum = 4.7

[libraries]
linux.x86_64 = "res://addons/godot_aerodynamic_physics/godot-cpp-components/bin/linux/libgodot_aerodynamic_physics.linux.template_debug.double.x86_64.so"

[icons]
AeroBody3D = "res://addons/godot_aerodynamic_physics/icons/AeroBody3D.svg"
AeroInfluencer3D = "res://addons/godot_aerodynamic_physics/icons/AeroInfluencer3D.svg"
AeroSurface3D = "res://addons/godot_aerodynamic_physics/icons/AeroSurface3D.svg"