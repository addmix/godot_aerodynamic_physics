{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "group": { "kind": "build", "isDefault": true },
            "type": "shell",
            "command": "${config:gap.shell}",
            "args": ["${config:gap.shellFlag}", "${config:gap.buildExtension}"],
            "options": { "cwd": "${workspaceFolder}/godot-cpp-components" },
            "problemMatcher": "$gcc", // MSVC builds: change to "$msCompile"
            "detail": "Compile the GDExtension. Command: gap.buildExtension in settings.json."
        },
        {
            // Rebuilds the godot-cpp submodule itself (only needed after regenerating extension_api or updating godot-cpp).
            "label": "build-godot-cpp",
            "group": "build",
            "type": "shell",
            "command": "${config:gap.shell}",
            "args": ["${config:gap.shellFlag}", "${config:gap.buildGodotCpp}"],
            "options": { "cwd": "${workspaceFolder}/godot-cpp-components/godot-cpp" },
            "problemMatcher": "$gcc", // MSVC builds: change to "$msCompile"
            "detail": "Rebuild the godot-cpp submodule. Command: gap.buildGodotCpp in settings.json."
        }
    ]
}