{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  // "program" resolves via gap.godotEditorBin in .vscode/settings.json — override there per machine.
  // WINDOWS + MSVC: change each "type" below from "cppdbg" to "cppvsdbg".
  // WINDOWS + MinGW: keep "cppdbg" and add "MIMode": "gdb" and "miDebuggerPath": "<path to gdb.exe>".
  "configurations": [
    {
      "name": "editor (cppdbg)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${config:gap.godotEditorBin}",
      "args": [
        "--editor",
        //"--debug",
        //"--verbose",
        "--path",
        "../.."
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "preLaunchTask": "build"
    },
    {
      "name": "project (cppdbg)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${config:gap.godotEditorBin}",
      "args": [
        //"--debug",
        //"--verbose",
        "--path",
        "../.."
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "preLaunchTask": "build"
    },
  ]
}